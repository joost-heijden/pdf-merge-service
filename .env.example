# Vereist: maak zelf een willekeurig token van minstens 32 tekens.
# Deze lege waarde is bewust geen bruikbaar geheim.
PDF_API_TOKEN=

# Voor lokaal starten. Compose zet HOST/PORT binnen de container zelf.
HOST=127.0.0.1
PORT=3000

PDF_MAX_DOCUMENTS=20
PDF_MAX_INPUT_BYTES=20971520
PDF_MAX_OUTPUT_BYTES=20971520
PDF_MAX_PAGES=500
PDF_JOB_TIMEOUT_MS=10000
PDF_MAX_CONCURRENT=2
PDF_REQUEST_TIMEOUT_MS=30000
